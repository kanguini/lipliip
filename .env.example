# Base de dados PostgreSQL (local: docker run -e POSTGRES_PASSWORD=lipliip -p 5432:5432 postgres:16)
DATABASE_URL="postgresql://postgres:lipliip@localhost:5432/lipliip"

# URL pública da aplicação (usada nos links dos convites)
APP_URL="http://localhost:3000"

# Envio de SMS para validação dos convidados: "console" (imprime o código no terminal) ou "twilio"
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""            # número Twilio ou "whatsapp:+1415..." para WhatsApp

# Em desenvolvimento, mostra o código OTP no ecrã do convidado (nunca ative em produção)
SHOW_OTP_IN_DEV="true"

# Recuperação de palavra-passe por email: "console" (imprime no terminal) ou "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Liplip <no-reply@liplip.online>"
