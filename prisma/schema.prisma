// Esquema de dados da plataforma de convites digitais.
// PostgreSQL em produção e desenvolvimento (ver README para arrancar um Postgres local).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?
  passwordHash String
  role         String          @default("USER") // USER | ADMIN
  suspendedAt  DateTime? // conta bloqueada pelo administrador
  notifiedAt   DateTime? // última vez que viu as notificações
  createdAt    DateTime        @default(now())
  events       Event[]
  sessions     Session[]
  resets       PasswordReset[]
  memberships  EventMember[]
  orders          Order[]
  reviewedOrders  Order[]          @relation("OrderReviewer")
  serviceRequests ServiceRequest[]
  media           Media[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Event {
  id                   String    @id @default(cuid())
  ownerId              String
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type                 String // WEDDING | ENGAGEMENT | BIRTHDAY | OTHER
  templateId           String
  title                String // ex: "Casamento de Ana & João"
  hostNames            String // ex: "Ana & João"
  message              String? // texto de abertura do convite
  date                 DateTime
  endTime              String? // "23:30"
  venueName            String
  venueAddress         String?
  mapsUrl              String?
  venueLat             Float? // coordenadas escolhidas no mapa
  venueLng             Float?
  dressCode            String?
  coverImageUrl        String?
  accentColor          String? // sobrepõe a cor principal do template
  country              String    @default("AO") // país por omissão para normalizar telefones
  timezone             String    @default("Africa/Luanda") // fuso horário do evento
  currency             String    @default("AOA")
  rsvpDeadline         DateTime?
  allowChildren        Boolean   @default(true)
  verificationRequired Boolean   @default(true) // exige OTP por SMS para abrir o convite
  maxDevicesPerGuest   Int       @default(2)
  guestbookEnabled     Boolean   @default(true)
  giftsEnabled         Boolean   @default(true)
  programJson          String? // JSON: [{time, title, description}]
  musicUrl             String? // MP3/áudio de fundo do convite
  galleryJson          String? // JSON: [url, url, ...]
  storyJson            String? // JSON: [{date, title, text, imageUrl}] história do casal / do aniversariante
  partyJson            String? // JSON: [{name, role, imageUrl}] padrinhos, madrinhas, damas...
  hashtag              String? // ex: #AnaEJoao2027
  extraInfo            String? // informações úteis: alojamento, transporte, estacionamento
  envelopeEnabled      Boolean   @default(true) // animação de abertura do envelope
  songRequestsEnabled  Boolean   @default(true) // convidados podem sugerir músicas
  contributionIban     String?
  contributionMbway    String?
  contributionNote     String?
  menuJson             String? // ementa (secções e pratos) mostrada aos convidados
  liveGalleryEnabled   Boolean   @default(true) // convidados partilham fotos no dia
  requestsEnabled      Boolean   @default(true) // convidados fazem pedidos (comida, bebida, música)
  activatedAt          DateTime? // evento pago/libertado pelo administrador
  checkinToken         String?   @unique // acesso de receção sem conta (link + PIN)
  checkinPin           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  guests    Guest[]
  gifts     GiftItem[]
  guestbook GuestbookEntry[]
  members   EventMember[]
  tasks     Task[]
  budget    BudgetItem[]
  vendors   Vendor[]
  photos          EventPhoto[]
  requests        GuestRequest[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  media           Media[]

  @@index([ownerId])
}

/// Quem pode trabalhar num evento além do dono: co-organizadores, cerimonialistas, equipa de receção.
model EventMember {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("EDITOR") // EDITOR (tudo menos eliminar/equipa) | STAFF (só check-in)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String? // Local, Catering, Fotografia...
  dueAt       DateTime?
  assignee    String? // nome de quem trata
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([eventId])
}

model Vendor {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    String
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  price       Float? // valor da proposta
  status      String       @default("CONTACTING") // CONTACTING | PROPOSAL | HIRED | REJECTED
  notes       String?
  createdAt   DateTime     @default(now())
  budgetItems BudgetItem[]

  @@index([eventId])
}

model BudgetItem {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   String
  name       String
  estimated  Float     @default(0)
  contracted Float? // valor fechado com o fornecedor
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime  @default(now())
  payments   Payment[]

  @@index([eventId])
}

model Payment {
  id           String     @id @default(cuid())
  budgetItemId String
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  label        String? // Sinal, 2ª prestação...
  amount       Float
  dueAt        DateTime?
  paidAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([budgetItemId])
}

model Guest {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  phone          String // E.164, ex: +351912345678
  email          String?
  token          String    @unique // link pessoal e intransmissível
  checkinCode    String    @unique // código curto para check-in no dia
  groupName      String? // Família, Amigos, Trabalho...
  tableNumber    String?
  maxCompanions  Int       @default(0)
  rsvpStatus     String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  companions     Int       @default(0)
  companionNames String?
  dietaryNotes   String?
  rsvpMessage    String?
  songRequest    String?
  respondedAt    DateTime?
  verifiedAt     DateTime?
  firstOpenedAt  DateTime?
  openCount      Int       @default(0)
  sentAt         DateTime?
  sentVia        String?
  checkedInAt    DateTime?
  suspendedAt    DateTime? // convite suspenso pelo organizador (sem acesso, reservas libertadas)
  lastViewedAt   DateTime? // última abertura contabilizada (uma por 30 min)
  createdAt      DateTime  @default(now())

  devices      GuestDevice[]
  otps         OtpCode[]
  accessLogs   AccessLog[]
  reservations GiftReservation[]
  guestbook    GuestbookEntry[]
  photos       EventPhoto[]
  requests     GuestRequest[]

  @@unique([eventId, phone])
  @@index([eventId])
}

model GuestDevice {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([guestId])
}

model OtpCode {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([guestId])
}

model AccessLog {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  outcome   String // VIEW | OTP_SENT | OTP_OK | OTP_FAIL | OTP_RATE_LIMIT | DEVICE_LIMIT | CHECKIN
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([guestId])
}

model GiftItem {
  id           String            @id @default(cuid())
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind         String            @default("PRODUCT") // PRODUCT | CASH
  name         String
  description  String?
  price        Float?
  imageUrl     String?
  storeUrl     String?
  quantity     Int               @default(1)
  createdAt    DateTime          @default(now())
  reservations GiftReservation[]

  @@index([eventId])
}

model GiftReservation {
  id        String   @id @default(cuid())
  giftId    String
  gift      GiftItem @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  amount    Float?
  note      String?
  createdAt DateTime @default(now())

  @@unique([giftId, guestId])
  @@index([guestId])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([guestId])
}

/// Ficheiro (imagem ou comprovativo) guardado na base de dados, já redimensionado.
model Media {
  id          String   @id @default(cuid())
  kind        String   @default("IMAGE") // IMAGE | DOCUMENT
  mime        String
  size        Int
  width       Int?
  height      Int?
  data        Bytes
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  photos      EventPhoto[]
  orders      Order[]
  suppliers   Supplier[]

  @@index([eventId])
}

/// Fotografia do evento: do álbum dos anfitriões (ALBUM) ou partilhada por um convidado no dia (LIVE).
model EventPhoto {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String?
  guest     Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  mediaId   String
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind      String    @default("LIVE") // ALBUM | LIVE
  caption   String?
  hiddenAt  DateTime? // escondida pelos anfitriões
  createdAt DateTime  @default(now())

  @@index([eventId, kind])
  @@index([guestId])
}

/// Pedido feito por um convidado a partir do convite (comida, bebida, música, outro).
model GuestRequest {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  kind      String    @default("OTHER") // FOOD | DRINK | MUSIC | OTHER
  text      String
  status    String    @default("NEW") // NEW | DONE
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId, status])
  @@index([guestId])
}

/// Configuração global da plataforma (uma única linha, id "default").
model PlatformSettings {
  id              String   @id @default("default")
  eventPrice      Float    @default(0) // preço de ativação de um evento
  currency        String   @default("AOA")
  bankName        String?
  bankAccount     String? // IBAN / número de conta
  bankHolder      String?
  paymentNote     String? // instruções mostradas ao utilizador
  freeGuestLimit  Int      @default(5) // convidados que se podem adicionar antes da ativação
  gatePlanner     Boolean  @default(false) // bloquear planeamento antes da ativação
  gateSharing     Boolean  @default(true) // bloquear envio/abertura dos convites antes da ativação
  updatedAt       DateTime @updatedAt
}

/// Pedido de ativação de um evento por transferência bancária, com comprovativo, aprovado pelo administrador.
model Order {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amount       Float
  currency     String
  reference    String    @unique // referência a indicar na transferência
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  proofMediaId String?
  proof        Media?    @relation(fields: [proofMediaId], references: [id], onDelete: SetNull)
  note         String? // nota do utilizador
  adminNote    String? // motivo de rejeição, etc.
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("OrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

/// Fornecedor do diretório público (salões, buffet, decoração, música, …), gerido pelo administrador.
model Supplier {
  id           String           @id @default(cuid())
  name         String
  category     String
  city         String?
  province     String?
  address      String?
  lat          Float?
  lng          Float?
  phone        String?
  whatsapp     String?
  email        String?
  website      String?
  description  String?
  imageMediaId String?
  image        Media?           @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  featured     Boolean          @default(false)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requests     ServiceRequest[]

  @@index([category])
  @@index([active, featured])
}

/// Pedido de orçamento/contacto feito a um fornecedor através da plataforma.
model ServiceRequest {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  email      String?
  message    String
  status     String    @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt  DateTime  @default(now())

  @@index([supplierId, status])
}

/// Estado de cada template (ativo, premium), editável pelo administrador.
model TemplateSetting {
  id        String   @id // templateId
  enabled   Boolean  @default(true)
  premium   Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Template personalizado: um cartaz carregado pela administração que passa a estar disponível como modelo de convite.
/// A imagem é o fundo do cartaz (4:5) e o texto do convite é sobreposto por cima (como uma foto de capa).
model CustomTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String   @default("")
  tag           String   @default("")
  types         String[] // tipos de evento em que se aplica (WEDDING, ENGAGEMENT, BIRTHDAY, OTHER)
  imageMediaId  String // fundo do cartaz (Media)
  accentColor   String   @default("#541b38") // cor de destaque do convite (botões, divisórias)
  bgColor       String   @default("#fbf5f7") // fundo das secções do convite
  textColor     String   @default("#30262e")
  sampleNames   String   @default("Sofia & Miguel")
  sampleCaption String   @default("Uma vida inteira começa aqui.")
  enabled       Boolean  @default(true)
  premium       Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
