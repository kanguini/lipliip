// Esquema de dados da plataforma de convites digitais.
// PostgreSQL em produção e desenvolvimento (ver README para arrancar um Postgres local).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?
  passwordHash String
  createdAt    DateTime        @default(now())
  events       Event[]
  sessions     Session[]
  resets       PasswordReset[]
  memberships  EventMember[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Event {
  id                   String    @id @default(cuid())
  ownerId              String
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type                 String // WEDDING | ENGAGEMENT | BIRTHDAY | OTHER
  templateId           String
  title                String // ex: "Casamento de Ana & João"
  hostNames            String // ex: "Ana & João"
  message              String? // texto de abertura do convite
  date                 DateTime
  endTime              String? // "23:30"
  venueName            String
  venueAddress         String?
  mapsUrl              String?
  dressCode            String?
  coverImageUrl        String?
  accentColor          String? // sobrepõe a cor principal do template
  country              String    @default("PT") // país por omissão para normalizar telefones
  timezone             String    @default("Europe/Lisbon") // fuso horário do evento
  currency             String    @default("EUR")
  rsvpDeadline         DateTime?
  allowChildren        Boolean   @default(true)
  verificationRequired Boolean   @default(true) // exige OTP por SMS para abrir o convite
  maxDevicesPerGuest   Int       @default(2)
  guestbookEnabled     Boolean   @default(true)
  giftsEnabled         Boolean   @default(true)
  programJson          String? // JSON: [{time, title, description}]
  musicUrl             String? // MP3/áudio de fundo do convite
  galleryJson          String? // JSON: [url, url, ...]
  storyJson            String? // JSON: [{date, title, text, imageUrl}] história do casal / do aniversariante
  partyJson            String? // JSON: [{name, role, imageUrl}] padrinhos, madrinhas, damas...
  hashtag              String? // ex: #AnaEJoao2027
  extraInfo            String? // informações úteis: alojamento, transporte, estacionamento
  envelopeEnabled      Boolean   @default(true) // animação de abertura do envelope
  songRequestsEnabled  Boolean   @default(true) // convidados podem sugerir músicas
  contributionIban     String?
  contributionMbway    String?
  contributionNote     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  guests    Guest[]
  gifts     GiftItem[]
  guestbook GuestbookEntry[]
  members   EventMember[]
  tasks     Task[]
  budget    BudgetItem[]
  vendors   Vendor[]

  @@index([ownerId])
}

/// Quem pode trabalhar num evento além do dono: co-organizadores, cerimonialistas, equipa de receção.
model EventMember {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("EDITOR") // EDITOR (tudo menos eliminar/equipa) | STAFF (só check-in)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String? // Local, Catering, Fotografia...
  dueAt       DateTime?
  assignee    String? // nome de quem trata
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([eventId])
}

model Vendor {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    String
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  price       Float? // valor da proposta
  status      String       @default("CONTACTING") // CONTACTING | PROPOSAL | HIRED | REJECTED
  notes       String?
  createdAt   DateTime     @default(now())
  budgetItems BudgetItem[]

  @@index([eventId])
}

model BudgetItem {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   String
  name       String
  estimated  Float     @default(0)
  contracted Float? // valor fechado com o fornecedor
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime  @default(now())
  payments   Payment[]

  @@index([eventId])
}

model Payment {
  id           String     @id @default(cuid())
  budgetItemId String
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  label        String? // Sinal, 2ª prestação...
  amount       Float
  dueAt        DateTime?
  paidAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([budgetItemId])
}

model Guest {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  phone          String // E.164, ex: +351912345678
  email          String?
  token          String    @unique // link pessoal e intransmissível
  checkinCode    String    @unique // código curto para check-in no dia
  groupName      String? // Família, Amigos, Trabalho...
  tableNumber    String?
  maxCompanions  Int       @default(0)
  rsvpStatus     String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  companions     Int       @default(0)
  companionNames String?
  dietaryNotes   String?
  rsvpMessage    String?
  songRequest    String?
  respondedAt    DateTime?
  verifiedAt     DateTime?
  firstOpenedAt  DateTime?
  openCount      Int       @default(0)
  sentAt         DateTime?
  sentVia        String?
  checkedInAt    DateTime?
  suspendedAt    DateTime? // convite suspenso pelo organizador (sem acesso, reservas libertadas)
  lastViewedAt   DateTime? // última abertura contabilizada (uma por 30 min)
  createdAt      DateTime  @default(now())

  devices      GuestDevice[]
  otps         OtpCode[]
  accessLogs   AccessLog[]
  reservations GiftReservation[]
  guestbook    GuestbookEntry[]

  @@unique([eventId, phone])
  @@index([eventId])
}

model GuestDevice {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([guestId])
}

model OtpCode {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([guestId])
}

model AccessLog {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  outcome   String // VIEW | OTP_SENT | OTP_OK | OTP_FAIL | OTP_RATE_LIMIT | DEVICE_LIMIT | CHECKIN
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([guestId])
}

model GiftItem {
  id           String            @id @default(cuid())
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind         String            @default("PRODUCT") // PRODUCT | CASH
  name         String
  description  String?
  price        Float?
  imageUrl     String?
  storeUrl     String?
  quantity     Int               @default(1)
  createdAt    DateTime          @default(now())
  reservations GiftReservation[]

  @@index([eventId])
}

model GiftReservation {
  id        String   @id @default(cuid())
  giftId    String
  gift      GiftItem @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  amount    Float?
  note      String?
  createdAt DateTime @default(now())

  @@unique([giftId, guestId])
  @@index([guestId])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([guestId])
}
